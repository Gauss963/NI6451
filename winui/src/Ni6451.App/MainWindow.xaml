<Window
    x:Class="Ni6451.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ni6451.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="12" RowSpacing="8" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Live sensor readout: trigger status pinned left, sensor values pinned right. -->
        <Grid Grid.Row="0">
            <TextBlock
                x:Name="TriggerStatusText"
                Text="Trigger: No"
                Style="{StaticResource ReadoutTextStyle}"
                Margin="0"
                HorizontalAlignment="Left" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="NormalStressText" Text="Normal: -- MPa" Style="{StaticResource ReadoutTextStyle}" />
                <TextBlock x:Name="ShearStressText" Text="Shear: -- MPa" Style="{StaticResource ReadoutTextStyle}" />
                <TextBlock x:Name="LvdtText" Text="LVDT: -- mm" Style="{StaticResource ReadoutTextStyle}" />
            </StackPanel>
        </Grid>

        <!-- Acquisition settings -->
        <Border Grid.Row="1" Style="{StaticResource SectionBorderStyle}">
            <StackPanel Spacing="8">
                <TextBlock Text="Acquisition Settings" Style="{StaticResource SectionHeaderStyle}" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Device:" Style="{StaticResource FieldLabelStyle}" Width="60" />
                    <ComboBox x:Name="DeviceCombo" Width="240" IsEditable="True" />
                    <Button x:Name="RefreshButton" Content="Refresh" Click="OnRefreshDevices" />
                </StackPanel>

                <TextBlock x:Name="FixedParamsText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <CheckBox x:Name="CaptureTriggerCheck" Content="Capture TTL trigger on:" VerticalAlignment="Center" />
                    <TextBox x:Name="TriggerLineBox" Width="140" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ai0 normal-stress fault setup -->
        <Border Grid.Row="2" Style="{StaticResource SectionBorderStyle}">
            <StackPanel Spacing="8">
                <TextBlock Text="ai0: Normal Stress Setup" Style="{StaticResource SectionHeaderStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Fault type:" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox x:Name="FaultTypeCombo" Width="90" SelectionChanged="OnFaultTypeChanged" />
                    <TextBlock Text="Thickness:" Style="{StaticResource FieldLabelStyle}" Margin="16,0,6,0" />
                    <ComboBox x:Name="FaultThicknessCombo" Width="220" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Output naming -->
        <Border Grid.Row="3" Style="{StaticResource SectionBorderStyle}">
            <StackPanel Spacing="8">
                <TextBlock Text="Output Naming" Style="{StaticResource SectionHeaderStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="SH (4-digit, zero-padded):" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="ShBox" Width="70" MaxLength="4" TextChanged="OnNamingChanged" />
                    <TextBlock Text="RN (run number):" Style="{StaticResource FieldLabelStyle}" Margin="16,0,6,0" />
                    <NumberBox
                        x:Name="RnBox"
                        Width="130"
                        SpinButtonPlacementMode="Compact"
                        SmallChange="1"
                        ValueChanged="OnRunNumberChanged" />
                </StackPanel>
                <TextBlock x:Name="FileNamePreviewText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- Output folder + Start/Stop -->
        <Grid Grid.Row="4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="ChooseFolderButton" Grid.Column="0" Content="Choose Output Folder" Click="OnChooseFolder" />
            <TextBlock
                x:Name="OutputFolderText"
                Grid.Column="1"
                Text="No output folder selected"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis" />
            <Button x:Name="StartButton" Grid.Column="2" Content="Start" Width="90" IsEnabled="False" Click="OnStart" />
            <Button x:Name="StopButton" Grid.Column="3" Content="Stop" Width="90" IsEnabled="False" Click="OnStop" />
        </Grid>

        <!-- Live trace display -->
        <controls:LiveTraceView x:Name="TraceView" Grid.Row="5" />

        <TextBlock x:Name="StatusText" Grid.Row="6" Text="Status: idle" TextTrimming="CharacterEllipsis" />
    </Grid>

</Window>
