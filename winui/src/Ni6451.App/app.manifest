<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="2.0.0.0" name="Ni6451.App" />

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- WinUI 3 requires PerMonitorV2; the live traces are redrawn per frame so they
           stay crisp when the window is moved between displays of different DPI. -->
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
  <!--
    Registration-free WinRT for Win2D.

    The app ships unpackaged, so there is no AppxManifest for Win2D's build targets to register
    its runtime classes in. Without these entries RoGetActivationFactory has no idea which DLL
    implements Microsoft.Graphics.Canvas.UI.Xaml.CanvasControl, and the XAML parser reports
    only "Cannot create instance of type LiveTraceView". Every public runtime class in
    Microsoft.Graphics.Canvas.winmd (Win2D 1.3.2) is listed; the list was generated from the
    metadata rather than typed by hand. Regenerate it if Win2D is upgraded.
  -->
  <file name="Microsoft.Graphics.Canvas.dll">
      <activatableClass name="Microsoft.Graphics.Canvas.Brushes.CanvasImageBrush" threadingModel="both" xmlns="urn:schemas-microsoft-com:winrt.v1" />
      <activatableClass name="Microsoft.Graphics.Canvas.Brushes.CanvasLinearGradientBrush" threadingModel="both" xmlns="urn:schemas-microsoft-com:winrt.v1" />
