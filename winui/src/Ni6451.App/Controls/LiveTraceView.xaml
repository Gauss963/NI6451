<UserControl
    x:Class="Ni6451.App.Controls.LiveTraceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Window" Style="{StaticResource FieldLabelStyle}" />
                    <NumberBox
                        x:Name="WindowBox"
                        Width="118"
                        SpinButtonPlacementMode="Compact"
                        SmallChange="1"
                        ValueChanged="OnWindowChanged" />
                    <TextBlock Text="s" Style="{StaticResource FieldLabelStyle}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Y range" Style="{StaticResource FieldLabelStyle}" />
                    <NumberBox
                        x:Name="YRangeBox"
                        Width="126"
                        SpinButtonPlacementMode="Compact"
                        SmallChange="0.5"
                        ValueChanged="OnYRangeChanged" />
                    <TextBlock Text="± V" Style="{StaticResource FieldLabelStyle}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="SelectionSummary" Style="{StaticResource FieldLabelStyle}" Margin="0,0,6,0" />
                <Button x:Name="SelectAllButton" Content="All" MinWidth="52" Click="OnSelectAll" />
                <Button x:Name="SelectNoneButton" Content="None" MinWidth="52" Click="OnSelectNone" />
            </StackPanel>
        </Grid>

        <!-- Per-channel rows: left column ai0-ai7, right column ai8-ai15. Populated in
             code-behind so the 16 rows stay a loop rather than 16 copies of markup. -->
        <Grid x:Name="ChannelGrid" Grid.Row="1" ColumnSpacing="20" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
        </Grid>
    </Grid>

</UserControl>
