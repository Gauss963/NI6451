<UserControl
    x:Class="Ni6451.App.Controls.LiveTraceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
            <TextBlock Text="Time window (s):" Style="{StaticResource FieldLabelStyle}" />
            <NumberBox
                x:Name="WindowBox"
                Width="110"
                SpinButtonPlacementMode="Compact"
                SmallChange="1"
                ValueChanged="OnWindowChanged" />

            <TextBlock Text="Y range (± V):" Style="{StaticResource FieldLabelStyle}" Margin="16,0,6,0" />
            <NumberBox
                x:Name="YRangeBox"
                Width="120"
                SpinButtonPlacementMode="Compact"
                SmallChange="0.5"
                ValueChanged="OnYRangeChanged" />

            <Button x:Name="SelectAllButton" Content="Select All" Margin="16,0,0,0" Click="OnSelectAll" />
            <Button x:Name="SelectNoneButton" Content="Select None" Click="OnSelectNone" />
        </StackPanel>

        <!-- Per-channel rows: left column ai0-ai7, right column ai8-ai15. Populated in
             code-behind so the 16 rows stay a loop rather than 16 copies of markup. -->
        <Grid x:Name="ChannelGrid" Grid.Row="1" ColumnSpacing="20" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
        </Grid>
    </Grid>

</UserControl>
