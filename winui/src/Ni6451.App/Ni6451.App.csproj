<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Ni6451.App</RootNamespace>
    <AssemblyName>Ni6451</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- WinUI 3, deployed unpackaged: the build output is a plain, double-clickable
         Ni6451.exe with the Windows App SDK and the .NET runtime carried alongside it,
         so the lab machines need nothing installed except the NI-DAQmx driver. -->
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>

    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>false</PublishReadyToRun>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefaultLanguage>en-US</DefaultLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.*" />
    <!-- Win2D backs the 16 live traces. XAML shapes would mean rebuilding up to 32,000
         Points every frame at 20 fps; Win2D draws straight to a Direct2D surface instead. -->
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ni6451.Core\Ni6451.Core.csproj" />
    <ProjectReference Include="..\Ni6451.Daq\Ni6451.Daq.csproj" />
  </ItemGroup>

</Project>
