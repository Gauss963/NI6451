<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Ni6451.App</RootNamespace>
    <AssemblyName>Ni6451</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- WinUI 3, deployed unpackaged: the build output is a plain, double-clickable
         Ni6451.exe with the Windows App SDK and the .NET runtime carried alongside it,
         so the lab machines need nothing installed except the NI-DAQmx driver. -->
    <UseWinUI>true</UseWinUI>
    <!-- Required even though the app ships unpackaged: this is what wires up the MSIX/PRI build
         tasks that MrtCore.PriGen.targets loads. Without it the build fails with MSB4062 looking
         for Microsoft.Build.Packaging.Pri.Tasks.dll inside the .NET SDK, where it does not live. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>

    <!-- Program.cs supplies Main so startup can be logged and a failure shown; see StartupLog. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>false</PublishReadyToRun>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefaultLanguage>en-US</DefaultLanguage>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned rather than floating: the XAML compiler resolves types out of these packages'
         WinMDs, and a mismatched set makes it fail with no diagnostic at all. Microsoft.Windows.SDK.BuildTools
         is deliberately not referenced here — the App SDK pulls the version it was built against,
         and overriding it is one way to produce exactly that failure. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.241114003" />
    <!-- Win2D backs the 16 live traces. XAML shapes would mean rebuilding up to 32,000
         Points every frame at 20 fps; Win2D draws straight to a Direct2D surface instead.
         Win2D 1.3.2 declares a dependency on Microsoft.WindowsAppSDK 1.6.241114003, so the two are
         pinned to exactly that pair. Win2D 1.4.0 moves to App SDK 1.8, and mixing the generations
         produces duplicate MSBuild imports and a build that cannot be reasoned about. -->
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ni6451.Core\Ni6451.Core.csproj" />
    <ProjectReference Include="..\Ni6451.Daq\Ni6451.Daq.csproj" />
  </ItemGroup>

  <!-- The App SDK publishes a Microsoft.ui.xaml.dll.mui for ninety-odd languages, each in its
       own folder. They only localise the XAML framework's own strings (e.g. the text in a
       ContentDialog's default buttons); the neutral copy is embedded in the DLL itself, so
       dropping a language folder loses nothing but that translation. Keep English and
       Traditional Chinese and delete the rest — it is most of the clutter in the output. -->
  <Target Name="TrimAppSdkLanguageFolders" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <_AppSdkMui Include="$(PublishDir)*\Microsoft.ui.xaml.dll.mui" />
      <_AppSdkMuiDir Include="@(_AppSdkMui->'%(RootDir)%(Directory)')" />
      <_AppSdkMuiDirToRemove Include="@(_AppSdkMuiDir)"
        Condition="!$([System.String]::Copy('%(Identity)').ToLowerInvariant().TrimEnd('\').EndsWith('en-us')) and !$([System.String]::Copy('%(Identity)').ToLowerInvariant().TrimEnd('\').EndsWith('zh-tw'))" />
    </ItemGroup>
    <RemoveDir Directories="@(_AppSdkMuiDirToRemove)" />
    <Message Importance="high" Text="Removed @(_AppSdkMuiDirToRemove->Count()) App SDK language folders from the publish output." />
  </Target>

</Project>
