<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Deliberately platform-neutral: the acquisition-independent logic (rolling buffer,
         unit conversion, .npy/.npz container) builds and runs on any OS, so it stays
         testable from a non-Windows machine. -->
    <RootNamespace>Ni6451.Core</RootNamespace>
    <AssemblyName>Ni6451.Core</AssemblyName>
  </PropertyGroup>

</Project>
