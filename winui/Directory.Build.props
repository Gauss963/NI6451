<Project>

  <!-- Settings shared by every project in the WinUI rewrite. Scoped to winui/ so it
       cannot affect anything on the main branch. -->
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Company>NTU Rock Friction Lab</Company>
    <Product>USB-6451 Continuous Acquisition</Product>
    <Version>2.0.0</Version>
  </PropertyGroup>

</Project>
